+int ModuleManager::instance_layer_offset(const ModuleId& parent, const ModuleId& child, size_t instance) const {
+  auto it = instance_layer_offsets_.find(std::make_tuple(parent, child, instance));
+  return it == instance_layer_offsets_.end() ? -1 : it->second;
+}
+
+void ModuleManager::set_instance_layer_offset(const ModuleId& parent, const ModuleId& child, size_t instance, int offset) {
+  VTR_ASSERT(valid_module_id(parent) && valid_module_id(child));
+  VTR_ASSERT(instance < num_instance(parent, child) && offset >= 0);
+  instance_layer_offsets_[std::make_tuple(parent, child, instance)] = offset;
+}
