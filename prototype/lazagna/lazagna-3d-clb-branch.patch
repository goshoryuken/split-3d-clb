+        <port name="addr" clock="clk" combinational_sink_ports="dataout"/>
+        <!-- address lines -->
+        <port name="datain" clock="clk" combinational_sink_ports="dataout"/>
+        <!-- data lines can be broken down into smaller bit widths minimum size 1 -->
