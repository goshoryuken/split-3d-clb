diff --git a/scripts/apply_3d_clb.sh b/scripts/apply_3d_clb.sh
new file mode 100755
index 0000000..4a8ca72
--- /dev/null
+++ b/scripts/apply_3d_clb.sh
@@ -0,0 +1,19 @@
+#!/bin/bash
+# Applies the 3D CLB changes in patches/3d_clb to LaZagna's OpenFPGA and VTR submodules,
+# then rebuilds. Safe to run again: a patch that is already applied is skipped.
+# Usage: bash scripts/apply_3d_clb.sh [make -j count, default 8]
+set -e
+ROOT=$(cd "$(dirname "$0")/.." && pwd)
+P=$ROOT/patches/3d_clb
+apply() {
+  repo=$1; patch=$2
+  if git -C "$repo" apply --reverse --check "$patch" 2>/dev/null; then
+    echo "$(basename "$patch"): already applied"
+  else
+    git -C "$repo" apply "$patch"
+    echo "$(basename "$patch"): applied"
+  fi
+}
+apply "$ROOT/OpenFPGA/vtr-verilog-to-routing" "$P/vtr.patch"
+apply "$ROOT/OpenFPGA" "$P/openfpga.patch"
+cd "$ROOT" && make all -j"${1:-8}"
