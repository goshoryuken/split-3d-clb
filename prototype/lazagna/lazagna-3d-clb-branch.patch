+++ b/setup_files/3d_clb_local20_split.yaml
@@ -0,0 +1,29 @@
+# ============================================================
+# LaZagna Setup - 3D CLB, 20 LUTs split 10 and 10, each layer reading its own pins
+# ============================================================
+# One CLB tile spans layers 0 and 1 (layer_span="2"); FLEs 0-9 and pins I0 sit on
+# layer 0, FLEs 10-19 and pins I1 on layer 1 (instance_layer_offsets, pin_layer).
+# Each layer's FLEs read only that layer's pins; feedback reaches all 20. LaZagna
+# gives both layer crossbars OpenFPGA's crossbar mux type in each job's copy of
+# the OpenFPGA settings. With clb_3d.split_layers, each job's CLB is also cut into one Verilog
+# module per layer, in tasks_run/<experiment>/task_<benchmark>/clb_layers.
+# Needs the VTR and OpenFPGA changes in patches/3d_clb (see docs/3d_clb.md).
+# ============================================================
+
+experiment_name: "3d_clb_local20_split"
+
+grid:
+  width_3d: 14
+  height_3d: 14
+  channel_width: 50
+
+architectures:
+  - type: 3d_cb
+    arch_file: "{lazagna_root}/arch_files/3d_clb/vtr_3d_clb_local20_arch.xml"
+
+clb_3d:
+  split_layers: true
+
+benchmarks:
+  directory: "{lazagna_root}/benchmarks/clb_compare"
+  is_verilog: false
