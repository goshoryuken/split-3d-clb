+          <direct name="address1" input="spram.addr[10:0]" output="mem_2048x10_sp.addr">
+          </direct>
+          <direct name="data1" input="spram.din[9:0]" output="mem_2048x10_sp.datain">
+          </direct>
+          <direct name="writeen1" input="spram.we1" output="mem_2048x10_sp.we">
+          </direct>
